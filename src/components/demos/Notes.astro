---
// The Meetings window (Fn+M) as the app draws it (MeetingsView): the meetings by day on the left with the search field,
// the chosen one in the middle (title, when and who, the notes with their writer and their buttons, "My notes" under
// them), and the chat about it on the right, under the Chat | Transcript picker.
import { json } from '../../lib/json';
import type { Dict } from '../../i18n';

interface Props {
  t: Dict;
}
const d = Astro.props.t.notes.demo;
---

<div class="nd" data-notes>
  <script type="application/json" data-script set:html={json(d)} />
  <div class="nd__win" aria-hidden="true">
    <div class="nd__bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="nd__wtitle">{d.window}</span>
      <svg class="nd__toggle" viewBox="0 0 20 16"><rect x="1" y="1" width="18" height="14" rx="3"></rect><path d="M7 1v14M3.4 4.5h1.6M3.4 7h1.6M3.4 9.5h1.6"></path></svg>
    </div>

    <div class="nd__body">
      <aside class="nd__side">
        <div class="nd__search">
          <svg viewBox="0 0 16 16"><circle cx="6.8" cy="6.8" r="4.6"></circle><path d="M10.3 10.3 14 14"></path></svg>
          {d.search}
        </div>
        {
          d.days.map((day, i) => (
            <>
              <p class="nd__day">{day}</p>
              {d.list
                .filter((m) => m[0] === i)
                .map((m, j) => (
                  <div class:list={['nd__row', i === 0 && j === 0 && 'on']}>
                    <span class="nd__row-title">{m[1]}</span>
                    <span class="nd__row-meta">
                      {m[2]}
                      {i === 0 && j === 0 ? (
                        <>
                          <span class="nd__row-writing" data-row-writing> · {d.writingRow}</span>
                          <svg class="nd__row-notes" data-row-notes viewBox="0 0 12 10"><path d="M1 1.5h10M1 4h10M1 6.5h10M1 9h6"></path></svg>
                        </>
                      ) : (
                        <svg class="nd__row-notes show" viewBox="0 0 12 10"><path d="M1 1.5h10M1 4h10M1 6.5h10M1 9h6"></path></svg>
                      )}
                    </span>
                  </div>
                ))}
            </>
          ))
        }
      </aside>

      <article class="nd__doc">
        <div class="nd__head">
          <p class="nd__title">{d.title}</p>
          <svg class="nd__more" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6"></circle><circle class="dot" cx="6" cy="10" r="1.1"></circle><circle class="dot" cx="10" cy="10" r="1.1"></circle><circle class="dot" cx="14" cy="10" r="1.1"></circle></svg>
        </div>
        <p class="nd__meta">{d.meta}</p>
        <hr class="nd__rule" />
        <div class="nd__nhead">
          <b>{d.notesH}</b>
          <span class="nd__by" data-by>{d.by}</span>
          <span class="nd__sp"></span>
          <span class="nd__busy" data-busy><i class="nd__spin"></i><span class="nd__small">{d.stop}</span></span>
          <span class="nd__tools" data-tools>
            <svg viewBox="0 0 16 16"><rect x="5" y="2" width="8.5" height="10" rx="1.6"></rect><path d="M3 4.5v8.2c0 .9.7 1.6 1.6 1.6H11"></path></svg>
            <svg viewBox="0 0 16 16"><path d="M10.8 2.6l2.6 2.6L6 12.6 2.8 13.4l.8-3.2z"></path></svg>
            <span class="nd__rewrite"><svg viewBox="0 0 16 16"><path d="M8 1.5 9.2 6.8 14.5 8 9.2 9.2 8 14.5 6.8 9.2 1.5 8 6.8 6.8z"></path></svg>{d.rewrite}</span>
          </span>
        </div>
        <p class="nd__reading" data-reading>{d.reading}</p>
        <div class="nd__sec" data-sec>
          <p class="nd__h">{d.summaryH}</p>
          <p class="nd__p" data-summary></p>
        </div>
        <div class="nd__sec" data-sec>
          <p class="nd__h">{d.decisionsH}</p>
          <ul class="nd__list" data-decisions></ul>
        </div>
        <div class="nd__sec" data-sec>
          <p class="nd__h">{d.actionsH}</p>
          <ul class="nd__list" data-actions></ul>
        </div>
        <div class="nd__mine">
          <b>{d.mine}</b>
          <div class="nd__minebox">
            {d.jotted.map((line, i) => <p class="nd__jot" data-jot={i}>{line}</p>)}
          </div>
          <p class="nd__caption">{d.mineCaption}</p>
        </div>
      </article>

      <section class="nd__panel">
        <div class="nd__seg"><span class="on">{d.chat}</span><span>{d.transcript}</span></div>
        <div class="nd__chat">
          <div class="nd__ask" data-asklist>
            <p>{d.askLead}</p>
            {d.chips.map((chip, i) => <span class="nd__link" data-chip={i}>{chip}</span>)}
          </div>
          <p class="nd__q" data-q>{d.ask}</p>
          <i class="nd__spin nd__wait" data-wait></i>
          <p class="nd__a" data-a></p>
        </div>
        <div class="nd__input">
          <span>{d.input}</span>
          <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="9"></circle><path d="M10 14.5v-9M6.2 9.2 10 5.4l3.8 3.8"></path></svg>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  import '../../scripts/demos/notes';
</script>
