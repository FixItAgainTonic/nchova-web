---
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import Footer from './Footer.astro';
import { CONTACT_EMAIL } from '../config';
import { dicts, path, type Lang } from '../i18n';

// The site's legal pages, privacy and terms: a title, sections with a heading each, the contact address at the end.

interface Props {
  lang: Lang;
  doc: 'privacyPage' | 'termsPage';
  page: string;
}
const t = dicts[Astro.props.lang];
const p = t[Astro.props.doc];
const home = path(Astro.props.lang);
---

<Base lang={Astro.props.lang} title={p.metaTitle} description={t.meta.description} page={Astro.props.page} ocean={false}>
  <main id="main" class="legal">
    <div class="wrap legal__in">
      <a class="legal__home" href={home}><Mark class="nav__mark" /> <span class="nav__word">nchova</span></a>
      <h1 class="feature__title">{p.title}</h1>
      {'updated' in p && <p class="legal__date mono">{p.updated}</p>}
      {
        p.sections.map(([h, body, anchor], i) => (
          <section class="legal__sec" id={anchor}>
            <h2 class="mono">{h}</h2>
            <p>
              {body}
              {i === p.sections.length - 1 && (
                <>
                  {' '}
                  <a class="link" href={`mailto:${CONTACT_EMAIL}`}>
                    {CONTACT_EMAIL}
                  </a>
                </>
              )}
            </p>
          </section>
        ))
      }
      <p><a class="link" href={home}>{p.back}</a></p>
    </div>
  </main>
  <Footer t={t} />
</Base>
