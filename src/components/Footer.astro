---
import { CONTACT_EMAIL, LANGUAGES } from '../config';
import { dicts, path, type Dict, type Lang } from '../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const f = t.footer;
const others = LANGUAGES.filter((l) => l !== t.lang);
---

<footer class="footer" data-footer>
  <div class="wrap">
    <p class="footer__word" aria-hidden="true">nchova</p>
    <div class="footer__row">
      <p class="footer__colophon">{f.colophon}</p>
      <nav class="footer__links mono" aria-label="footer">
        <a href={path(t.lang as Lang, 'privacy/')}>{f.privacy}</a>
        <a href={path(t.lang as Lang, 'terms/')}>{f.terms}</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{f.contact}</a>
        {
          others.map((l) => (
            <a href={path(l)} hreflang={l} lang={l}>
              {dicts[l].langName}
            </a>
          ))
        }
        <span>{f.rights}</span>
      </nav>
    </div>
  </div>
</footer>

<script>
  import { Tank } from '../scripts/fish/tank';

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer) {
    new Tank(footer, {
      edges: 'turn',
      pointer: true,
      fish: (w) => (w < 700 ? [34] : [30, 52]).map((size) => ({ size, alpha: 0.9 })),
      start: (i, w, h) => ({ x: [0.2, 0.7][i] * w, y: [0.35, 0.55][i] * h }),
    });
  }
</script>
