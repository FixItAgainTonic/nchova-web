---
import Bracket from './Bracket.astro';
import Mark from './Mark.astro';
import { DOWNLOAD_URL, LANGUAGES } from '../config';
import { dicts, path, type Dict, type Lang } from '../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const home = path(t.lang as Lang);
// The language switch appears once there is more than one language.
const others = LANGUAGES.filter((l) => l !== t.lang);
---

<a class="skip" href="#main">{t.nav.skip}</a>
<header class="nav" data-nav>
  <div class="wrap nav__in">
    <a class="nav__brand" href={home} aria-label="nchova">
      <Mark class="nav__mark" />
      <span class="nav__word">nchova</span>
    </a>
    <nav class="nav__links mono" aria-label="nchova">
      {t.nav.items.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>
    <div class="nav__end">
      {
        others.map((l) => (
          <a class="nav__lang mono" href={path(l)} hreflang={l} lang={l} title={dicts[l].langName}>
            {l.toUpperCase()}
          </a>
        ))
      }
      <a class="btn btn--sm" href={`${DOWNLOAD_URL}?from=nav`}><Bracket>{t.nav.cta}</Bracket></a>
    </div>
  </div>
</header>
