---
import Bracket from './Bracket.astro';
import Mark from './Mark.astro';
import { DOWNLOAD_URL, LANGUAGES } from '../config';
import { dicts, path, type Dict, type Lang } from '../i18n';

interface Props {
  t: Dict;
  /** Off the home page the sections are links back to it. */
  away?: boolean;
  /** The download button's source, for the count (src/pages/download.ts). */
  from?: string;
  /** This page within its language, and the languages it exists in: the switch leads to the same page elsewhere. */
  page?: string;
  langs?: Lang[];
}
const { t, away = false, from = 'nav', page = '', langs = LANGUAGES } = Astro.props;
const lang = t.lang as Lang;
const home = path(lang);
const to = away ? home : '';
// The language switch appears once there is more than one language; a language without this page leads to its home.
const others = LANGUAGES.filter((l) => l !== lang);
---

<a class="skip" href="#main">{t.nav.skip}</a>
<header class="nav" data-nav>
  <div class="wrap nav__in">
    <a class="nav__brand" href={home} aria-label="nchova">
      <Mark class="nav__mark" />
      <span class="nav__word">nchova</span>
    </a>
    <nav class="nav__links mono" aria-label="nchova">
      {t.nav.items.map(([id, label]) => <a href={`${to}#${id}`}>{label}</a>)}
    </nav>
    <div class="nav__end">
      {
        others.length > 0 && (
          <details class="nav__langs mono" data-langs>
            <summary aria-label={t.nav.language}>{lang.toUpperCase()}</summary>
            <ul>
              {others.map((l) => (
                <li>
                  <a href={langs.includes(l) ? path(l, page) : path(l)} hreflang={l} lang={l}>
                    {dicts[l].langName}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <a class="btn btn--sm" href={`${DOWNLOAD_URL}?from=${from}`}><Bracket>{t.nav.cta}</Bracket></a>
    </div>
  </div>
</header>
