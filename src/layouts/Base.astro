---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/demos.css';
import { SITE } from '../config';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The same page in the other language. */
  alternate: string;
  ocean?: boolean;
}

const { lang, title, description, alternate, ocean = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const other = new URL(alternate, SITE).href;
const ogImage = new URL(lang === 'it' ? '/og.png' : '/og-en.png', SITE).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'it' ? 'it' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={lang === 'it' ? 'en' : 'it'} href={other} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'it' ? Astro.url.pathname : alternate, SITE).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2eee6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nchova" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {ocean && <div class="ocean" data-ocean aria-hidden="true"></div>}
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
