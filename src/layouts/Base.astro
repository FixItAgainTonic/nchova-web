---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/demos.css';
import { COMPANY, CONTACT_EMAIL, LANGUAGES, PRO_PRICE, SITE } from '../config';
import { json } from '../lib/json';
import { DEFAULT, path, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page within its language: '' for home, 'privacy/'. */
  page?: string;
  ocean?: boolean;
  /** Describe nchova to search engines (the home page). */
  product?: boolean;
}

const { lang, title, description, page = '', ocean = true, product = false } = Astro.props;
const canonical = new URL(path(lang, page), SITE).href;
// The same page in every published language, once there is more than one.
const alternates = LANGUAGES.length > 1 ? LANGUAGES.map((l) => ({ l, href: new URL(path(l, page), SITE).href })) : [];
const ogImage = new URL(`/og-${lang}.png`, SITE).href;
const locale = { en: 'en_GB', it: 'it_IT' }[lang];
const org = { '@type': 'Organization', '@id': `${SITE}/#org`, name: COMPANY.name, vatID: `IT${COMPANY.vat}`, email: CONTACT_EMAIL, url: `${SITE}/` };
const structured = product && {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    {
      '@type': 'SoftwareApplication',
      name: 'nchova',
      url: canonical,
      description,
      image: ogImage,
      inLanguage: lang,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'macOS 26 or later',
      publisher: { '@id': org['@id'] },
      offers: [
        { '@type': 'Offer', name: 'nchova', price: '0', priceCurrency: PRO_PRICE.currency },
        { '@type': 'Offer', name: 'nchova Pro', price: PRO_PRICE.amount, priceCurrency: PRO_PRICE.currency },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(path(DEFAULT, page), SITE).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2eee6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nchova" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    {structured && <script type="application/ld+json" set:html={json(structured)} />}
  </head>
  <body>
    {ocean && <div class="ocean" data-ocean aria-hidden="true"></div>}
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
